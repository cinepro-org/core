{
  "version": 2,
  "functions": {
    "src/index.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 10
    }
  },
  "env": {
    "NODE_ENV": "production",
    "API_KEY": "@api_key", 
    "DB_URL": "@db_url"
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/src/index.ts" }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "probes": [
    {
      "path": "/",
      "mustContain": "Welcome"
    }
  ]
}
